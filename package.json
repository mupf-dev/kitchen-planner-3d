{
  "name": "k-chenplaner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch server/index.ts",
    "build": "tsc && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "three": "^0.186.1",
    "three-gpu-pathtracer": "^0.0.26",
    "three-mesh-bvh": "^0.9.15"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "engines": {
    "node": ">=22.18"
  }
}
